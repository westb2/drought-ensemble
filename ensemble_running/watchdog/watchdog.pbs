#!/bin/bash
#PBS -N restart_watchdog
#PBS -A UPRI0032
#PBS -q casper
#PBS -m ae
#PBS -M benjaminwest@arizona.edu
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=1:mem=4GB
#PBS -j oe
#PBS -o /glade/derecho/scratch/bwest/drought-ensemble/ensemble_running/watchdog/logs/

# Heavy scan + optional tip cleanup + Derecho qsub. Triggered by cron_driver.sh.
# Set WATCHDOG_APPLY=0 to force dry-run reports only.

set -euo pipefail

WATCHDOG_APPLY="${WATCHDOG_APPLY:-1}"
ROOT="/glade/derecho/scratch/bwest/drought-ensemble"
WD="${ROOT}/ensemble_running/watchdog"
LOGDIR="${WD}/logs"
mkdir -p "${LOGDIR}"

# The droughts env has activation hooks that reference unbound variables, so
# `set -u` kills the job before any scan happens.
set +u
module load conda
conda activate droughts
set -u

stamp="$(date +%Y%m%d_%H%M%S)"
json_out="${LOGDIR}/summary_${stamp}.json"
log="${LOGDIR}/watchdog_${stamp}.log"

cd "${WD}"

args=(--config "${WD}/config.yaml" --json-out "${json_out}")
if [[ "${WATCHDOG_APPLY}" == "1" ]]; then
  args+=(--apply)
fi

echo "[$(date -Is)] starting restart_watchdog.py ${args[*]}" | tee -a "${log}"

# tee would otherwise mask a non-zero exit (e.g. the fail-closed qstat path),
# leaving a job that looks successful while nothing was checked.
set +e
python3 "${WD}/restart_watchdog.py" "${args[@]}" 2>&1 | tee -a "${log}"
rc=${PIPESTATUS[0]}
set -e

echo "[$(date -Is)] done rc=${rc}" | tee -a "${log}"

if (( rc != 0 )); then
  mail -s "drought-ensemble watchdog scan FAILED (rc=${rc})" benjaminwest@arizona.edu \
    <"${log}" 2>/dev/null || echo "could not send failure mail" | tee -a "${log}"
fi

exit "${rc}"
